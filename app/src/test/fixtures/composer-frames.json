{
 "comment": "composer 判定前后端一致性样例（做空 N2）。guards 与插件 composer_guard 的声明由 Rust 测试逐字核对；Rust session_settings::composer_state 与前端 composerCandidate 对每一帧（原样与去掉行尾空格两种）都必须给出 expect。 Gemini YOLO 档提示符是 *（做空 R2，g7-2 实拍）；OpenCode 一轮之后 / --session 打开后空输入框只剩 ┃（真机高 1，round3 实拍）。",
 "guards": {
  "gemini": {
   "prompt_footer": false,
   "input_start_pattern": "^(\\s*[>*] )",
   "top_pattern": "^(?:─+|▄+)\\s*$",
   "bottom_pattern": "^(?:─+|▀+)\\s*$",
   "row_pattern": "^ (.*)$",
   "prompt_prefix": ">|*",
   "tail_rows": 0,
   "tail_pattern": null,
   "empty_pattern": "^(?:Type your message or @path/to/file)?$"
  },
  "kimi": {
   "prompt_footer": false,
   "input_start_pattern": "^(\\s*│ > )",
   "top_pattern": "^\\s*╭─+╮\\s*$",
   "bottom_pattern": "^\\s*╰─+╯\\s*$",
   "row_pattern": "^\\s*│(.*)│\\s*$",
   "prompt_prefix": ">",
   "tail_rows": 0,
   "tail_pattern": null,
   "empty_pattern": "^$"
  },
  "codex": {
   "prompt_footer": true,
   "input_start_pattern": "^(› )",
   "top_pattern": "^› ",
   "bottom_pattern": "^  [A-Za-z0-9][^\\r\\n]* · .+$",
   "row_pattern": "^(?:› |  )(.*)$",
   "prompt_prefix": "",
   "tail_rows": 0,
   "tail_pattern": null,
   "empty_pattern": "^(?:Ask Codex to do anything)?$"
  },
  "opencode": {
   "prompt_footer": false,
   "input_start_pattern": "^(\\s*┃  |\\s*┃$)",
   "top_pattern": "^\\s*┃\\s*$",
   "bottom_pattern": "^\\s*╹▀+\\s*$",
   "row_pattern": "^\\s*┃(.*)$",
   "prompt_prefix": "",
   "tail_rows": 2,
   "tail_pattern": "^\\s*┃\\s+\\S.* · .+$",
   "empty_pattern": "^(?:Ask anything…(?: \"[^\"\\r\\n]*\")?)?$"
  }
 },
