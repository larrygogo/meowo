              "old_start": 0,
              "new_start": 1,
              "lines": [
                "+//! 仅为managed原生成功工具事实提供保守目标识别；未知脚本不能靠提到.lead就认领。",
                "+",
                "+pub(crate) fn lead_shell_write(command:&str)->bool {",
                "+    let line=command.lines().next().unwrap_or(\"\");",
                "+    if line.contains([';', '|', '`'])||line.contains(\"$(\")||line.contains(\"&&\")||line.contains(\"||\") {return false;}",
                "+    let Some(index)=line.find('>')else{return false};",
                "+    if index>0&&line.as_bytes()[index-1].is_ascii_digit(){return false;}",
                "+    let target=line[index+1..].trim_start_matches('>').trim_start().trim_start_matches(['\\'', '\"']);",
                "+    let target=target.split_whitespace().next().unwrap_or(\"\").trim_end_matches(['\\'', '\"']).replace('\\\\',\"/\");",
                "+    target.starts_with(\".lead/\")||target.contains(\"/.lead/\")",
                "+}"
              ]
            }
          ],
          "added": 11,
          "removed": 0,
          "truncated": false
        }
      ]
